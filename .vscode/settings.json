{
    "[javascript][typescript][svelte][json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4
    },
    "[github-actions-workflow]": {
        "editor.tabSize": 2
    },
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "js/ts.implicitProjectConfig.target": "ESNext",
    "js/ts.preferences.importModuleSpecifier": "non-relative",
    "js/ts.preferences.importModuleSpecifierEnding": "minimal",
    "oxc.typeAware": true,
    "eslint.validate": [
        "javascript",
        "typescript",
        "svelte"
    ],
    "files.exclude": {
        "coverage": true
    },
    "typescript.native-preview.additionalTsdkLocations": [
        "./frontend/node_modules/@typescript/native-preview"
    ],
    "typescript.native-preview.tsdk": "./frontend/node_modules/@typescript/native-preview",
    "oxc.requireConfig": true,
    "oxc.configPath": "./frontend/.oxlintrc.json"
}