{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "prepreview": "pnpm run build",
        "preview": "pnpm run serve",
        "serve": "pnpx http-server -p 5173 -c-1 dist/",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "check:types": "pnpm node scripts/svelte-check.ts",
        "lint:oxlint": "oxlint . --type-aware --type-check --report-unused-disable-directives-severity=error",
        "lint:eslint": "eslint --no-error-on-unmatched-pattern --cache --cache-location ./node_modules/.cache/eslint/ \"src/**/*.svelte\" \"src/**/*.svelte.ts\" \"test/**/*.svelte\" \"test/**/*.svelte.ts\"",
        "lint": "pnpm run lint:oxlint --fix && pnpm run lint:eslint --fix",
        "lint:check": "concurrently --group \"pnpm run check:types\" \"pnpm run lint:oxlint\" \"pnpm run lint:eslint\"",
        "format": "pnpm run format:check --write --list-different",
        "format:check": "prettier --cache --cache-location ./node_modules/.cache/prettier/ src/ test/ worker/"
    },
    "author": "",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.18.0 <23.0.0 || >=23.6.0"
