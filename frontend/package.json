{
    "name": "frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "prepreview": "pnpm run build",
        "preview": "pnpm run serve",
        "serve": "pnpx http-server -p 5173 -c-1 dist/",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "check": "pnpm run format && pnpm run lint && pnpm run test",
        "check:types": "concurrently --group \"svelte-check --tsconfig tsconfig.app.json --fail-on-warnings\" \"svelte-check --tsconfig tsconfig.worker.json --fail-on-warnings\" \"svelte-check --tsconfig tsconfig.test.json\"",
        "lint:oxlint": "oxlint . --type-aware --type-check --report-unused-disable-directives-severity=error",
        "lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint/ src/ test/",
        "lint": "pnpm run lint:oxlint --fix && pnpm run lint:eslint --fix",
        "lint:check": "concurrently --group \"pnpm run check:types\" \"pnpm run lint:oxlint\" \"pnpm run lint:eslint\"",
        "format": "pnpm run format:check --write --list-different",
        "format:check": "prettier --cache --cache-location ./node_modules/.cache/prettier/ src/ test/ worker/"
    },
    "author": "",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
    "engines": {
        "node": ">=22.18.0 <23.0.0 || >=23.6.0"
    },
    "dependencies": {
        "@arisutalk/character-spec": "0.0.17",
        "@humanspeak/svelte-markdown": "^0.8.17",
        "@langchain/anthropic": "^1.3.19",
        "@langchain/core": "^1.1.27",
        "@langchain/google-genai": "^2.1.20",
        "@langchain/openai": "^1.2.9",
        "adze": "^2.3.0",
        "cbor-x": "^1.6.0",
        "comlink": "^4.4.2",
        "define-function": "^2.0.0",
        "dexie": "^4.3.0",
        "lodash-es": "^4.17.23",
        "phosphor-svelte": "^3.1.0",
        "svelte": "^5.53.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/postcss": "^4.2.1",
        "@types/lodash-es": "^4.17.12",
        "@vitest/browser": "^4.0.18",
        "@vitest/browser-playwright": "^4.0.18",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "autoprefixer": "^10.4.24",
        "concurrently": "^9.2.1",
        "daisyui": "^5.5.19",
        "eslint": "^9.39.3",
        "eslint-plugin-oxlint": "^1.50.0",
        "eslint-plugin-phosphor-svelte": "^0.0.2",
        "eslint-plugin-svelte": "^3.15.0",
        "fake-indexeddb": "^6.2.5",
        "globals": "^16.5.0",
        "happy-dom": "^20.7.0",
        "oxlint": "^1.50.0",
        "oxlint-tsgolint": "^0.14.2",
        "playwright": "^1.58.2",
        "postcss": "^8.5.6",
        "prettier": "^3.8.1",
        "prettier-plugin-svelte": "^3.5.0",
        "rollup-plugin-visualizer": "^7.0.0",
        "svelte-check": "^4.4.3",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "vitest-browser-svelte": "^2.0.2"
    }
