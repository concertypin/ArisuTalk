{
	"include": [
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"src/*.js",
		"src/*.ts",
		"src/*.svelte"
	],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.cache/app.tsbuildinfo",
		"lib": [
			"ESNext",
			"DOM"
		],
		"types": [
			"vite/client",
			"svelte",
		],
		/* Type Checking */
		"noImplicitAny": true, /* Enable error reporting for expressions and declarations with an implied 'any' type. */
		"declarationDir": "./dist-ts/app"
	},
	"extends": "./tsconfig.base.json",
	"references": [
		{
			"path": "./tsconfig.worker.json"
		},
		{
			"path": "./tsconfig.common.json"
		}
	],
	"exclude": [
		"coverage",
		"dist-ts/",
		"dist/",
		"test/**/*.test.ts",
		"test/*.test.ts",
		"test/**/*.svelte",
	]
}