{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.cache/worker.tsbuildinfo",
		"composite": true,
		"lib": [
			"WebWorker",
			"ESNext"
		],
		"types": [
			"vite/client"
		],
		"allowImportingTsExtensions": false /* Allow imports to include TypeScript file extensions. Requires '--moduleResolution bundler' and either '--noEmit' or '--emitDeclarationOnly' to be set. */,
		"declarationDir": "./dist-ts/worker" /* Specify an output folder for all emitted files. */,
		"noEmit": false
	},
	"extends": "./tsconfig.base.json",
	"include": [
		"worker/**/*.ts"
	],
	"references": [
		{
			"path": "./tsconfig.common.json"
		}
	],
	"exclude": [
		"coverage",
		"dist-ts/",
		"dist/",
		"test/**/*.test.ts",
		"test/*.test.ts",
		"test/**/*.svelte",
	],
}